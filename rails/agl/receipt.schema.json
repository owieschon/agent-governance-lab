{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/owieschon/agent-governance-lab/blob/main/rails/agl/receipt.schema.json",
  "title": "Agent Governance Lab receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "scenario",
    "policy",
    "engine",
    "candidate",
    "tests",
    "checks",
    "verdict",
    "environment",
    "outputs",
    "receipt_sha256"
  ],
  "properties": {
    "$schema": { "const": "rails/agl/receipt.schema.json" },
    "schema_version": { "const": "agl.receipt.v1" },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "release_authority"],
      "properties": {
        "id": { "enum": ["test_only", "observe_only", "enforced"] },
        "release_authority": { "type": "boolean" }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "fingerprint", "commit", "source_dirty"],
      "properties": {
        "name": { "const": "Agent Governance Lab" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "fingerprint": { "$ref": "#/$defs/sha256" },
        "commit": { "type": "string", "pattern": "^([0-9a-f]{40,64}|NO-GIT)$" },
        "source_dirty": { "type": "boolean" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths",
        "initial_tree_hash",
        "initial_content_hash",
        "final_tree_hash",
        "final_content_hash"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "initial_tree_hash": { "$ref": "#/$defs/sha256" },
        "initial_content_hash": { "$ref": "#/$defs/sha256" },
        "final_tree_hash": { "$ref": "#/$defs/sha256" },
        "final_content_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "collected", "output_sha256"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "collected": { "type": "integer", "minimum": 0 },
        "output_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "detail"],
          "properties": {
            "passed": { "type": "boolean" },
            "detail": { "type": "string" }
          }
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "released", "reason"],
      "properties": {
        "status": { "enum": ["RELEASED", "BLOCKED"] },
        "released": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "python", "shell"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "python": { "type": "string", "minLength": 1 },
        "shell": { "type": "string", "minLength": 1 }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_candidate_snapshot",
        "final_candidate_snapshot",
        "verifier_verdict",
        "verifier_output",
        "test_output"
      ],
      "properties": {
        "initial_candidate_snapshot": { "$ref": "#/$defs/artifact" },
        "final_candidate_snapshot": { "$ref": "#/$defs/artifact" },
        "verifier_verdict": { "$ref": "#/$defs/artifact" },
        "verifier_output": { "$ref": "#/$defs/artifact" },
        "test_output": { "$ref": "#/$defs/artifact" }
      }
    },
    "receipt_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
